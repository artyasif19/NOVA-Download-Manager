{
  "manifest_version": 2,
  "name": "NOVA Download Manager Integration",
  "version": "2.4.0",
  "description": "Seamlessly intercepts browser downloads and captures video streams for NOVA Download Manager.",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@nova-download-manager.local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
