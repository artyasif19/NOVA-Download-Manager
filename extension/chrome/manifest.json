{
  "manifest_version": 3,
  "name": "NOVA Download Manager Integration",
  "version": "2.4.0",
  "key": "",
  "description": "Seamlessly intercepts browser downloads and captures video streams for NOVA Download Manager.",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NOVA Download Manager"
  }
}
