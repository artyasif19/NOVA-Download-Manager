  "description": "Permissions for the NOVA main window (window controls, folder picker, paths)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
